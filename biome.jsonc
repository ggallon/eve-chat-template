{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "files": {
    "includes": ["!**/*.svg", "!!components/ui", "!!lib/db/migrations"]
  },
  "linter": {
    "rules": {
      "a11y": {
        "noNoninteractiveElementInteractions": "warn",
        "noSvgWithoutTitle": "off",
        "useKeyWithClickEvents": "warn"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "info",
        "noVoid": "off"
      },
      "performance": {
        "noImgElement": "warn"
      },
      "style": {
        "useConsistentTypeDefinitions": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["agent/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false,
                "requireAscii": true,
                "filenameCases": ["snake_case"]
              }
            }
          }
        }
      }
    }
  ]
}
